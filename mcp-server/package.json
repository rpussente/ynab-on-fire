{
  "name": "ynab-on-fire-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for the YNAB API, authorised via OAuth",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/index.ts auth",
    "logout": "tsx src/index.ts logout",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src/"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "open": "^11.0.4",
    "ynab": "^4.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "bin": {
    "ynab-on-fire-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  }
}
